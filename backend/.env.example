# Copy to backend/.env and fill in. Every value is optional.

# Password for the admin UI/API (HTTP Basic; any user name). Strongly recommended in production.
ADMIN_PASSWORD=

DATA_DIR=data
WORKERS=2
RENDER_DPI=300
TESSERACT_LANG=fas
# Folder with tessdata_best models (the Docker image sets /opt/tessdata_best)
TESSDATA_DIR=/opt/tessdata_best

# AI engines (best accuracy). Leave empty to run fully offline with Tesseract.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DEFAULT_AI_ENGINE=claude
# From a server in Iran: route AI calls through a proxy or a relay abroad.
# HTTPS_PROXY=http://user:pass@proxy-host:3128
# ANTHROPIC_BASE_URL=https://relay.example.com
# GEMINI_BASE_URL=https://relay.example.com

# DADROSE site integration (push approved questions)
DADROSE_API_URL=
DADROSE_API_TOKEN=
